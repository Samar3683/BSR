# ---------------------------------------------------------------------------
# BSR — environment variables (names only; never commit real values).
# Copy to .env.local for local development (`pnpm db:start` writes one for you).
# The admin panel's backend is plain PostgreSQL accessed ONLY by the Next.js
# server; nothing below is ever sent to a browser.
# ---------------------------------------------------------------------------

# Application connection to PostgreSQL: a login role with limited rights
# (it may switch into the request roles and manage the auth tables; it owns
# no tables). Example: postgresql://bsr_app:PASSWORD@host:5432/bsr
DATABASE_URL=

# Signs the session cookie. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public base URL of the site, used in emailed links (password reset,
# invitations). Falls back to the address of the incoming request.
APP_URL=

# Outgoing email for password resets and administrator invitations.
# smtp://user:password@host:587 (STARTTLS) or smtps://user:password@host:465.
SMTP_URL=
MAIL_FROM=BSR Trasporti <no-reply@example.com>

# Optional: who is emailed when a quote request or a message arrives
# (comma separated). The panel always shows them either way.
NOTIFY_EMAIL=

# Used only by `pnpm db:migrate`, `pnpm admin:create` and the database tests:
# a role that may create schemas, roles and extensions. Keep it out of the
# runtime environment of the web server.
DATABASE_ADMIN_URL=

# Optional: name of the application's login role (default bsr_app).
DATABASE_APP_ROLE=
