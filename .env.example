# ---------------------------------------------------------------------------
# BSR — environment variables (names only; never commit real values).
# Copy to .env.local for local development. The admin panel's backend is
# PostgreSQL accessed ONLY by the Next.js server (through Prisma); nothing
# below is ever sent to a browser. The local values below match compose.yaml
# (`npm run db:start`).
# ---------------------------------------------------------------------------

# Application connection to PostgreSQL: a login role with limited rights
# (it may switch into the request roles and manage the auth tables; it owns
# no tables). Local: postgresql://bsr_app@localhost:54320/bsr
# Elsewhere: postgresql://bsr_app:PASSWORD@host:5432/bsr?sslmode=require
DATABASE_URL=

# Signs the session cookie. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public base URL of the site, used in emailed links (password reset,
# invitations). Falls back to the address of the incoming request.
APP_URL=

# Outgoing email for password resets and administrator invitations.
# smtp://user:password@host:587 (STARTTLS) or smtps://user:password@host:465.
# Local: smtp://127.0.0.1:54325 (the Docker mail sink writes to .local/mail/).
SMTP_URL=
MAIL_FROM=BSR Trasporti <no-reply@example.com>

# Optional: who is told about new quote requests (comma-separated addresses).
NOTIFY_EMAIL=

# Used only by the Prisma CLI (`npm run db:migrate`, `npm run db:pull`),
# `npm run admin:create` and the database tests: the owner role that may
# create schemas, roles and extensions. Keep it out of the runtime
# environment of the web server. Local: postgresql://postgres@localhost:54320/bsr
DATABASE_ADMIN_URL=
