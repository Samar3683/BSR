# ---------------------------------------------------------------------------
# BSR — environment variables (names only; never commit real values).
# Copy to .env.local for local development.
# ---------------------------------------------------------------------------

# Browser-safe: Supabase project URL and public (anon / publishable) key.
# Used by the admin panel only; the public site does not read them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_, never expose to a browser.
# Used by scripts/admin/create-admin.mjs (bootstrap) and by the test tooling.
# Edge Functions receive it automatically from Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, server-side: direct Postgres connection for database tests
# (pnpm test:db) and migrations from CI.
SUPABASE_DB_URL=

# Edge Function secret (set with `supabase secrets set ADMIN_SITE_URL=...`):
# public origin of the site, used in admin invitation links.
# ADMIN_SITE_URL=https://www.example.com

# Test builds only (see playwright.config.ts).
# BSR_DESIGN_PREVIEW=true
# NEXT_PUBLIC_BSR_HERO_TEST_HOOKS=true
